# 环境
VITE_NODE_ENV=production

# 接口前缀
VITE_API_BASE_PATH=

# 打包路径（没用上）
VITE_BASE_PATH=/operation

# 是否删除debugger（测试环境保留，方便调试）
VITE_DROP_DEBUGGER=false

# 是否删除console.log（测试环境保留，方便调试）
VITE_DROP_CONSOLE=false

# 是否sourcemap（测试环境启用，方便调试）
VITE_SOURCEMAP=true

# 输出路径(没用上)
VITE_OUT_DIR=dist-test

# 标题
VITE_APP_TITLE='超能代理'
VITE_APP_TITLE_OPERATION='超能运营'


# 是否包分析（测试环境关闭，加快构建速度）
VITE_USE_BUNDLE_ANALYZER=false

# 是否全量引入element-plus样式（与生产一致，避免表格/下拉样式缺失）
VITE_USE_ALL_ELEMENT_PLUS_STYLE=true

# 是否开启mock
VITE_USE_MOCK=false

# 需要mock的接口（没用上）
VITE_MOCK_LIST=


# 是否切割css（测试环境启用，优化加载性能）
VITE_USE_CSS_SPLIT=true

# 是否使用在线图标
VITE_USE_ONLINE_ICON=true

# 是否隐藏全局设置按钮
VITE_HIDE_GLOBAL_SETTING=false

# 系统类型
VITE_SYSTEM_TYPE=Management