# 环境
VITE_NODE_ENV=development

# 接口前缀 - 旧后端（稳定）
VITE_API_BASE_PATH=https://test-chaoneng.gaod2o.shop/

# 打包路径
VITE_BASE_PATH=/

# 标题
VITE_APP_TITLE='机器人后台管理系统'

# 操作后台标题
VITE_APP_TITLE_OPERATION='机器人后台运营系统'

# 是否全量引入element-plus样式
VITE_USE_ALL_ELEMENT_PLUS_STYLE=true

# 是否开启mock
VITE_USE_MOCK=false

# 需要mock的接口
VITE_MOCK_LIST=

# 是否使用在线图标
VITE_USE_ONLINE_ICON=true

# 是否隐藏全局设置按钮（本地开发显示右侧「项目配置」；生产/测试见 .env.pro / .env.test）
VITE_HIDE_GLOBAL_SETTING=false

VITE_SYSTEM_TYPE='Operation'

VITE_TRONSCAN_URL=https://nile.tronscan.org

# 开发代理目标（可选，覆盖默认 API 地址用于 /v1 /v2 /api 转发）
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:2404
