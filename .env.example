# 复制为 .env.base / .env.dev / .env.pro 等后按需修改（这些文件已 gitignore）

# 环境
VITE_NODE_ENV=development

# 后端 API 地址（直连时使用；浏览器会跨域时需配合后端 CORS）
VITE_API_BASE_PATH=http://127.0.0.1:8888

# 开发代理目标（可选）。设置后 vite 将 /v1 /v2 /api 转发到此地址
# 未设置时回退到 VITE_API_BASE_PATH；两者皆空则不启用业务代理
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:2404

# 打包路径
VITE_BASE_PATH=/

# 标题
VITE_APP_TITLE='机器人后台管理系统'
VITE_APP_TITLE_OPERATION='机器人后台运营系统'

# 是否全量引入 element-plus 样式
VITE_USE_ALL_ELEMENT_PLUS_STYLE=true

# 是否开启 mock
VITE_USE_MOCK=false
VITE_MOCK_LIST=

# 是否使用在线图标
VITE_USE_ONLINE_ICON=true

# 是否隐藏全局设置按钮
VITE_HIDE_GLOBAL_SETTING=true

# 系统类型：Management | Operation（本地脚本 dev:m / dev:o 会覆盖）
VITE_SYSTEM_TYPE=Operation

# 区块链浏览器
VITE_TRONSCAN_URL=https://nile.tronscan.org
